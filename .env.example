# Copy to .env and fill in. `npm start` loads .env; never commit it.

# --- Dex -------------------------------------------------------------------------------------------
# Local `dexcli dev` (the default). For a remote Dex server, set the address, DEX_TLS=true, and the
# API key exchange: DEX_API_KEY, DEX_TOKEN_URL and DEX_SERVER_ID.
DEX_FLOW_SERVICE_ADDRESS=127.0.0.1:8801
# DEX_TLS=true
# DEX_API_KEY=
# DEX_TOKEN_URL=
# DEX_SERVER_ID=

# --- Dex Cloud account review API (staging) --------------------------------------------------------
# The demo reviews the sign-ups of Dex Cloud staging (https://dex.superdurable.io). The public host
# of its review API is set when the API is exposed; put it here then.
REVIEW_API_URL=https://review-api.example.invalid
# The key `srk_<id>_<secret>` a Dex Cloud platform admin issued for this demo. Secret.
REVIEW_API_KEY=
# Required: only sign-ups registered at or after this RFC 3339 time are reviewed, so the backlog is left alone.
SIGNUP_REVIEW_SINCE=2026-11-13T00:00:00Z

# --- Slack -----------------------------------------------------------------------------------------
# Channel ID of the review posts (channel details > Copy channel ID), such as C0123456789.
# The Slack app must be a member of the channel.
SLACK_REVIEW_CHANNEL=
# Member IDs (profile > Copy member ID) whose replies count, separated by commas.
SIGNUP_REVIEWER_SLACK_IDS=

# --- Connectors ------------------------------------------------------------------------------------
# The Dex connector configuration with the connections `review-slack` (Slack) and `welcome-gmail`
# (Gmail). Dex Web of `dexcli dev` writes it; see the README. Use an absolute path.
DEX_CONNECTOR_CONFIG_FILE=/Users/you/.dex/connectors/connections.json

# --- Agent -----------------------------------------------------------------------------------------
# pi or claude-agent-sdk. Each harness has its own session Flow type: finish the open reviews before switching.
SIGNUP_AGENT_HARNESS=pi
# pi: a <provider>/<model ID> of pi-ai's catalog, and the provider's key.
SIGNUP_AGENT_PI_MODEL=anthropic/claude-opus-5-5
ANTHROPIC_API_KEY=
# Claude Agent SDK: the model, and how the Claude Code CLI signs in: `login` uses the Claude Code login on this
# machine (run `claude` and /login once), `api-key` uses ANTHROPIC_API_KEY.
SIGNUP_AGENT_CLAUDE_MODEL=claude-opus-5-5
SIGNUP_AGENT_CLAUDE_AUTH=login
# Optional: a Claude Code CLI to run instead of the one the Claude Agent SDK bundles.
# SIGNUP_AGENT_CLAUDE_CLI=
# Optional: a GitHub token raises the public API's rate limit for github_user.
# GITHUB_TOKEN=

# Seconds between two reads of the pending sign-ups, and of each review thread.
SIGNUP_WATCH_INTERVAL_SECONDS=30
SIGNUP_THREAD_POLL_SECONDS=60
# Worker execution slots; each open review's ledger holds one while it polls.
SIGNUP_WORKER_SLOTS=64
